{
  "name": "mmm-onecallweather",
  "version": "3.6.1",
  "description": "Weather module for MagicMirror² using openweathermap.org One Call API.",
  "keywords": [
    "MagicMirror",
    "weather",
    "openweathermap"
  ],
  "type": "commonjs",
  "homepage": "https://github.com/KristjanESPERANTO/MMM-OneCallWeather#readme",
  "bugs": {
    "url": "https://github.com/KristjanESPERANTO/MMM-OneCallWeather/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KristjanESPERANTO/MMM-OneCallWeather"
  },
  "license": "MIT",
  "author": "Captsi",
  "contributors": [
    {
      "name": "Contributors to KristjanESPERANTO/MMM-OneCallWeather",
      "url": "https://github.com/KristjanESPERANTO/MMM-OneCallWeather/graphs/contributors"
    }
  ],
  "main": "MMM-OneCallWeather.js",
  "scripts": {
    "demo": "cd ../../ && MM_CONFIG_FILE=modules/MMM-OneCallWeather/demo.config.js node --run start:dev",
    "lint": "eslint && prettier . --check",
    "lint:fix": "eslint --fix && prettier . --write",
    "prepare": "simple-git-hooks || true",
    "release": "commit-and-tag-version --commit-all --config ./changelog.config.js",
    "test": "node --run test:unit && node --run lint && node --run test:spelling",
    "test:spelling": "cspell .",
    "test:unit": "node --test tests/**/*.test.mjs"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ]
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "commit-and-tag-version": "^13.2.0",
    "cspell": "^10.3.0",
    "eslint": "^10.10.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.12.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.14.0"
  },
  "allowScripts": {
    "simple-git-hooks@2.14.0": true,
    "unrs-resolver@1.12.2": true
  }
}
